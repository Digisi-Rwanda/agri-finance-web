# Local development
VITE_API_BASE_URL=http://localhost:8080/api

# Optional local overrides (production defaults live in `.env.production`)
# VITE_SUPPORT_EMAIL=support@agritrust.rw
# VITE_SUPPORT_URL=/support
# VITE_TERMS_URL=/terms
# VITE_PRIVACY_URL=/privacy
# VITE_MOBILE_APP_URL=https://play.google.com/store/apps/details?id=com.agritrust.agrifinance.app

# Production (also set the same keys in Vercel → Settings → Environment Variables if you prefer dashboard control):
#   VITE_API_BASE_URL=https://agri-finance-backendd.onrender.com/api
#   VITE_SUPPORT_EMAIL=support@agritrust.rw
#   VITE_SUPPORT_URL=https://agri-finance-web.vercel.app/support
#   VITE_TERMS_URL=https://agri-finance-web.vercel.app/terms
#   VITE_PRIVACY_URL=https://agri-finance-web.vercel.app/privacy
#   VITE_MOBILE_APP_URL=https://play.google.com/store/apps/details?id=com.agritrust.agrifinance.app
# Live site: https://agri-finance-web.vercel.app
# Backend:   https://agri-finance-backendd.onrender.com

# Spring Boot backend — must point reset emails at this web app (Vite), not port 8080:
# agri.app.web-base-url=http://localhost:5173
# Production on Render:
#   APP_WEB_BASE_URL=https://agri-finance-web.vercel.app
# On LAN / phone testing, use your PC IP for both:
#   VITE_API_BASE_URL=http://192.168.1.176:8080/api
#   agri.app.web-base-url=http://192.168.1.176:5173
